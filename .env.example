# Copie este arquivo para .env (cp .env.example .env) e preencha.

# Chave da API do provedor compatível com OpenAI (padrão: OpenAI oficial)
OPENAI_API_KEY=

# Modelo usado pelo agente
OPENAI_MODEL=gpt-4o-mini

# Endpoint da API (qualquer endpoint compatível com OpenAI).
# Padrão da SDK: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo de embeddings para o retrieval híbrido das políticas (opcional).
# Sem embeddings, o agente usa apenas BM25 e continua funcionando.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_EMBEDDINGS=true

# Comportamento do agente
AGENT_TEMPERATURE=0.3
MAX_TOOL_ROUNDS=5
HISTORY_MAX_MESSAGES=24
RAG_TOP_K=4
